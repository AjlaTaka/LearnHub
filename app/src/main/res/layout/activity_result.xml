<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:elevation="4dp"
        android:minHeight="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Course name -->
            <TextView
                android:id="@+id/tv_result_course_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Course Name"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textAlignment="center"
                android:layout_marginBottom="16dp" />

            <!-- Score card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_score"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="36dp">

                    <TextView
                        android:id="@+id/tv_score_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="85%"
                        android:textColor="@color/white"
                        android:textSize="72sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_letter_grade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="B"
                        android:textSize="48sp"
                        android:textStyle="bold"
                        android:layout_marginTop="-8dp" />

                    <TextView
                        android:id="@+id/tv_correct_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8 / 10 correct"
                        android:textColor="#CCE3F2FD"
                        android:textSize="18sp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tv_time_taken"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Time: 3:45"
                        android:textColor="#99E3F2FD"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- New Best badge (hidden unless new best) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_new_best"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/accent"
                app:cardElevation="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="🌟  New Personal Best Score!"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAlignment="center" />
            </androidx.cardview.widget.CardView>

            <!-- Feedback card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/surface">

                <TextView
                    android:id="@+id/tv_feedback_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:text="Great work!"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textAlignment="center"
                    android:lineSpacingMultiplier="1.4" />
            </androidx.cardview.widget.CardView>

            <!-- Action buttons -->
            <Button
                android:id="@+id/btn_retry_quiz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="🔄  Retry Quiz"
                android:textSize="15sp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:backgroundTint="@color/primary" />

            <Button
                android:id="@+id/btn_back_to_courses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="📚  Back to Courses"
                android:textSize="15sp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <Button
                android:id="@+id/btn_go_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏠  Home"
                android:textSize="15sp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
