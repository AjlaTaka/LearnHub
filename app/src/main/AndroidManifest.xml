<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.softeng.learnhub">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_app_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_app_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.LearnHub">

        <!-- SplashActivity: Entry point -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.LearnHub.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity: Home dashboard -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <!-- CourseListActivity: Browse 5 SE courses -->
        <activity
            android:name=".activities.CourseListActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- CourseDetailActivity: Lesson content per course -->
        <activity
            android:name=".activities.CourseDetailActivity"
            android:exported="false"
            android:parentActivityName=".activities.CourseListActivity" />

        <!-- QuizActivity: Interactive quiz per course -->
        <activity
            android:name=".activities.QuizActivity"
            android:exported="false"
            android:parentActivityName=".activities.CourseDetailActivity" />

        <!-- ResultActivity: Score + feedback after quiz -->
        <activity
            android:name=".activities.ResultActivity"
            android:exported="false"
            android:parentActivityName=".activities.QuizActivity" />

        <!-- LeaderboardActivity: SharedPreferences scores -->
        <activity
            android:name=".activities.LeaderboardActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- SettingsActivity: User preferences -->
        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- ProfileActivity: User profile + TTS feature -->
        <activity
            android:name=".activities.ProfileActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

    </application>
</manifest>
